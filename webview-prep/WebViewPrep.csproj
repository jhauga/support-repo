<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Package metadata for yak spec -->
    <Version>1.0.0</Version>
    <Title>WebView Prep</Title>
    <Description>Generate interactive web previews of Rhino models using three.js</Description>
    <Company>Acme Corp</Company>
    <Authors>Acme Corp</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Copy to Rhino's plugin folder for testing -->
  <PropertyGroup>
    <RhinoPlugInDir>$(APPDATA)\McNeel\Rhinoceros\packages\8.0\WebViewPrep</RhinoPlugInDir>
  </PropertyGroup>

  <Target Name="CopyToRhinoPlugInDir" AfterTargets="Build">
    <MakeDir Directories="$(RhinoPlugInDir)" Condition="!Exists('$(RhinoPlugInDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RhinoPlugInDir)" />
  </Target>

</Project>
